    cKeywords: ["원래 관심도","편드는","의도가","진짜 이유가 뭘까","수상","얼마 받았"],
    bKeywords: ["이상하긴","왜 갑자기"],
    reactions: {
      A: ["정정해줘서 다행"],
      B: ["음 그럴 수도 있겠다"],
