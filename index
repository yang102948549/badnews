  },
  {
    tag: "6단계 · 트롤링", title: "반박 여론이 커지고 있다",
    situation: "사실을 지적하는 댓글이 이어지며 반박 여론이 커지고 있다. 이 상황에 대응하는 게시물이나 댓글을 작성해보자.",
    followerMax: 1500, riskMax: 20,
    cKeywords: ["ㅋㅋ","증거있","신경꺼","웃기네","그래서 어쩌라고","진지충"],
    bKeywords: ["넘어가","글쎄"],
    reactions: {
      A: ["인정하는 모습 좋다"],
      B: ["음.. 넘어가는 분위기네"],
      C: ["ㅋㅋㅋ 이거 레전드", "증거 있음? 없으면 조용", "진지충 오지네 ㅋㅋ"]
    },
    feedback: {
      A: "논쟁을 멈추고 지적을 인정했습니다.",
      B: "구체적인 답 없이 화제를 돌렸습니다.",
      C: "논리에는 응답하지 않고 조롱으로 논의 자체를 무력화했습니다."
    }
  }
];

const RISK_GAMEOVER = 80;
const RISK_WARN = 60;

let state = { stage: 0, fame: 0, risk: 0 };

function $(id){ return document.getElementById(id); }
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  $(id).classList.add('active');
}

function buildDots(){
  const dots = $('dots'); dots.innerHTML = '';
  for(let i=0;i<STAGES.length;i++){
    const d = document.createElement('div');
    d.className = 'dot' + (i < state.stage ? ' done' : (i === state.stage ? ' now' : ''));
    dots.appendChild(d);
  }
}

function updateGauges(){
  const fameMax = STAGES.reduce((a,s)=>a+s.followerMax,0);
  $('fameFill').style.width = Math.min(100, (state.fame/fameMax)*100) + '%';
  $('fameValue').textContent = state.fame.toLocaleString();
  const riskPct = Math.min(100, state.risk);
  const fill = $('riskFill');
  fill.style.width = riskPct + '%';
  fill.style.background = state.risk >= RISK_GAMEOVER ? 'var(--danger)' : (state.risk >= RISK_WARN ? 'var(--warn)' : 'var(--safe)');
  $('riskValue').textContent = Math.round(state.risk);
  buildDots();
}

function startGame(){
  state = { stage:0, fame:0, risk:0 };
  updateGauges();
  renderStage();
  showScreen('stage');
}

function resetGame(){
  showScreen('intro');
}

function renderStage(){
  const s = STAGES[state.stage];
  $('stagepos').textContent = (state.stage+1) + ' / ' + STAGES.length;
  $('stageTag').textContent = s.tag;
  $('stageTitle').textContent = s.title;
  $('stageSituation').textContent = s.situation;
  $('answerInput').value = '';
  $('submitBtn').disabled = true;
  updateGauges();
}

document.addEventListener('input', function(e){
  if(e.target.id === 'answerInput'){
    $('submitBtn').disabled = e.target.value.trim().length < 2;
  }
});

/* ---- 데모용 키워드 휴리스틱 (실서비스에서는 Gemini가 대체) ---- */
function classify(stageData, text){
  const t = text.toLowerCase();
  let hits = 0;
  stageData.cKeywords.forEach(k => { if(t.includes(k.toLowerCase())) hits += 2; });
  stageData.bKeywords.forEach(k => { if(t.includes(k.toLowerCase())) hits += 1; });
  const exclaims = (text.match(/[!?]/g) || []).length;
  const laughs = (text.match(/ㅋ{2,}|ㄷㄷ/g) || []).length;
  hits += Math.min(2, Math.floor(exclaims/2)) + Math.min(2, laughs);

  let cls, ratio;
  if(hits >= 3){ cls = 'C'; ratio = 0.85; }
  else if(hits >= 1){ cls = 'B'; ratio = 0.45; }
  else { cls = 'A'; ratio = 0.05; }
  return { cls, ratio };
}

function submitAnswer(){
  const s = STAGES[state.stage];
  const text = $('answerInput').value.trim();
  const { cls, ratio } = classify(s, text);

  const followerDelta = Math.round(s.followerMax * ratio);
  const riskDelta = Math.round(s.riskMax * (cls==='A'?0:cls==='B'?0.4:0.85));

  state.fame += followerDelta;
  state.risk += riskDelta;

  $('postBody').textContent = text;
  $('likeStat').textContent = '❤ 좋아요 ' + Math.round(followerDelta*0.15).toLocaleString();
  $('shareStat').textContent = '🔁 공유 ' + Math.round(followerDelta*0.06).toLocaleString();

  const box = $('reactionsBox'); box.innerHTML = '';
  const reacts = s.reactions[cls];
  reacts.forEach((r, idx) => {
    const el = document.createElement('div');
    el.className = 'reaction';
    el.style.animationDelay = (idx*0.35) + 's';
    const names = ['ㅇㅇ','ㅁㅁ','ㅂㅂ','익명'];
    el.innerHTML = '<b>' + names[idx % names.length] + '</b>' + r;
    box.appendChild(el);
  });

  $('deltaFame').textContent = '+' + followerDelta.toLocaleString();
  $('deltaRisk').textContent = '+' + riskDelta;
  $('feedbackText').textContent = s.feedback[cls];

  updateGauges();

  $('nextBtn').textContent = (state.risk >= RISK_GAMEOVER)
    ? '결과 확인'
    : (state.stage === STAGES.length-1 ? '최종 결과 보기' : '다음 단계로 →');

  const post = $('postCard'); post.style.animation='none'; void post.offsetWidth; post.style.animation='';

  showScreen('result');
}

function proceed(){
  if(state.risk >= RISK_GAMEOVER){
    $('goFame').textContent = state.fame.toLocaleString();
    $('goStage').textContent = (state.stage+1) + '단계';
    showScreen('gameover');
    return;
  }
  if(state.stage < STAGES.length - 1){
    state.stage += 1;
    renderStage();
    showScreen('stage');
  } else {
    renderEnding();
    showScreen('ending');
  }
}

function renderEnding(){
  const box = $('endingScroll');
  const fame = state.fame;
  let html = '';
  if(fame >= 10000){
    html += `
      <div class="end-hero">
        <div class="display" style="color:var(--accent)">축하합니다!<br>팔로워 10,000명 달성</div>
        <p>당신은 '네임드' 계정이 되었습니다. 그런데—</p>
      </div>
      <div class="consequence-list">
        <div class="consequence">급식실 조리사님들이 억울함에 사직을 고민하고 있습니다.</div>
        <div class="consequence">1반 학생들과 학생회장은 근거 없는 비난 속에 대인기피를 겪고 있습니다.</div>
        <div class="consequence">경찰 사이버수사대에 접수되어 운영자의 신원이 특정되었습니다.</div>
        <div class="consequence">학교폭력대책심의위원회 소환 통보가 발송되었습니다.</div>
      </div>`;
  } else if(fame >= 3000){
    html += `
      <div class="end-hero">
        <div class="display">유명해지긴 했지만,<br>완전히 뜨진 못했습니다</div>
        <p>팔로워 ${fame.toLocaleString()}명을 모으는 동안 위험도 ${Math.round(state.risk)}까지 올랐습니다. 이만큼의 위험을 감수하고 얻은 결과입니다.</p>
      </div>`;
  } else {
    html += `
      <div class="end-hero">
        <div class="display">조용하지만<br>떳떳한 계정</div>
        <p>당신은 유명해지지 못했지만, 아무도 다치지 않았습니다. 정직한 노선도 하나의 선택지였습니다.</p>
      </div>`;
  }
  html += `
    <div class="end-stats">
      <div class="delta-chip fame"><span>최종 팔로워</span><span class="n">${fame.toLocaleString()}</span></div>
      <div class="delta-chip risk"><span>최종 위험도</span><span class="n">${Math.round(state.risk)}</span></div>
    </div>
    <div class="reflect">
      <ul>
        <li>숫자가 오를 때 어떤 기분이 들었나요?</li>
        <li>내가 누른 선택은 단순한 재미였을까요, 아니면 이 결과에 대한 책임이 있는 걸까요?</li>
      </ul>
    </div>
    <button class="btn btn-ghost" style="width:100%" onclick="resetGame()">다시 시작</button>
  `;
  box.innerHTML = html;
}
</script>
</body>
</html>
